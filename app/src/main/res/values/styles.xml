<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base de la aplicación (oscuro) -->
    <style name="Theme.Music1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accento_principal</item>
        <item name="colorPrimaryDark">@color/azul_profundo</item>
        <item name="colorAccent">@color/destello_play</item>
        <item name="android:windowBackground">@color/fondo_principal</item>
        <item name="android:colorBackground">@color/fondo_principal</item>
        <item name="android:textColorPrimary">@color/texto_primario</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:statusBarColor">@color/fondo_principal</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/fondo_secundario</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:itemTextAppearance">@style/Text.Body</item>
    </style>

    <!-- Tema para SplashActivity -->
    <style name="Theme.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <!-- Tema para LoadingActivity -->
    <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Transparent</item>
    </style>

    <!-- Animaciones -->
    <style name="Animation.Transparent" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
    </style>

    <!-- 🔥 NUEVOS ESTILOS DE TEXTO (fundamentos de diseño) -->
    <style name="Text.H1" parent="TextAppearance.AppCompat">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/texto_primario</item>
    </style>

    <style name="Text.H2" parent="TextAppearance.AppCompat">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/texto_primario</item>
    </style>

    <style name="Text.H3" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_primario</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/texto_terciario</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Estilo para botones redondeados -->
    <style name="Widget.RoundedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_rounded_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">12dp</item>
    </style>
    <!-- Estilo para avatar circular -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <!-- Sombra para las cards del carrusel -->
    <style name="CardView.Carrusel" parent="">
        <item name="cardElevation">8dp</item>
        <item name="cardMaxElevation">12dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="cardUseCompatPadding">true</item>
    </style>
    <style name="MenuPopupStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/fondo_secundario</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:itemTextAppearance">@style/Text.Body</item>
        <item name="android:colorControlNormal">@color/texto_primario</item>
    </style>
    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">60dp</item>
    </style>
</resources>