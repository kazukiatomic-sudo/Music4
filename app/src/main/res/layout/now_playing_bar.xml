<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingBar"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:background="@drawable/now_playing_background"
    android:elevation="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:gravity="center_vertical"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- Imagen/Portada -->
    <ImageView
        android:id="@+id/ivNowPlayingCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:src="@drawable/album1"
        android:contentDescription="Portada" />

    <!-- Información de la canción -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvNowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin reproducción"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvNowPlayingArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artista"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Botones de control -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Botón Play/Pause -->
        <ImageButton
            android:id="@+id/btnNowPlayingPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="Reproducir/Pausar" />

        <!-- Botón Siguiente -->
        <ImageButton
            android:id="@+id/btnNowPlayingNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_skip_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:contentDescription="Siguiente" />

    </LinearLayout>

</LinearLayout>