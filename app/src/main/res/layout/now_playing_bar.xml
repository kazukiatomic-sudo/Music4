<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/now_playing_background"
    android:elevation="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- FILA 1: Portada + Info + Cerrar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Portada circular -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <ImageView
                android:id="@+id/ivNowPlayingCover"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/album1"
                android:contentDescription="Portada" />
        </androidx.cardview.widget.CardView>

        <!-- Título y artista -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvNowPlayingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin reproducción"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:selected="true" />

            <TextView
                android:id="@+id/tvNowPlayingArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artista"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Botón favorito -->
        <ImageButton
            android:id="@+id/btnNowPlayingFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_favorite_border"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:tint="#AAAAAA"
            android:contentDescription="Favorito" />

        <!-- Botón cerrar -->
        <ImageButton
            android:id="@+id/btnNowPlayingClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:tint="#AAAAAA"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <!-- FILA 2: Controles de reproducción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Aleatorio -->
        <ImageButton
            android:id="@+id/btnNowPlayingShuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_shuffle"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:alpha="0.5"
            android:tint="@android:color/white"
            android:contentDescription="Aleatorio" />

        <!-- Anterior -->
        <ImageButton
            android:id="@+id/btnNowPlayingPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_skip_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:tint="@android:color/white"
            android:contentDescription="Anterior" />

        <!-- Play/Pause (botón principal, más grande) -->
        <ImageButton
            android:id="@+id/btnNowPlayingPlayPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:tint="@android:color/white"
            android:contentDescription="Reproducir/Pausar" />

        <!-- Siguiente -->
        <ImageButton
            android:id="@+id/btnNowPlayingNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_skip_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:tint="@android:color/white"
            android:contentDescription="Siguiente" />

        <!-- Repetir -->
        <ImageButton
            android:id="@+id/btnNowPlayingRepeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_repeat"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:alpha="0.5"
            android:tint="@android:color/white"
            android:contentDescription="Repetir" />
    </LinearLayout>

</LinearLayout>
