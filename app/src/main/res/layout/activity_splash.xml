<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_oscuro">

    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name_elegante"
            android:textColor="@color/white"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="#80FFFFFF"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="6"
            android:layout_marginBottom="16dp"
            android:alpha="0.0" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_elegante"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="48dp"
            android:alpha="0.0" />

        <ImageView
            android:id="@+id/btnIniciar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/btn_iniciar"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"
            android:alpha="0.0" />

        <View
            android:id="@+id/pulseEffect"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_pulse"
            android:layout_gravity="center"
            android:translationY="-60dp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>