<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal">

    <!-- 🔥 TOOLBAR CON MENÚ DE 3 PUNTOS -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fondo_secundario"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Reproductor"
        app:titleTextColor="@color/texto_primario"
        app:menu="@menu/menu_reproductor"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Dark" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:layout_marginTop="?attr/actionBarSize"
        app:layout_anchorGravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <!-- Contenedor del álbum — cuadrado centrado para que el disco circular no se corte -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_l">

                <androidx.cardview.widget.CardView
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="130dp"
                    app:cardElevation="@dimen/elevation_high">

                    <ImageView
                        android:id="@+id/albumCover"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_disco" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Info canción + Corazón -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l">

                <LinearLayout
                    android:id="@+id/infoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toLeftOf="@+id/favButton"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/songTitle"
                        style="@style/Text.H1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/songArtist"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/favButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="@dimen/spacing_xs"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/destello_favorito" />
            </RelativeLayout>

            <!-- SeekBar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_m"
                android:orientation="vertical">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/accento_principal"
                    android:thumbTint="@color/accento_principal" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/currentTime"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/totalTime"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Controles en CARRUSEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Controles"
                style="@style/Text.Caption"
                android:layout_marginBottom="@dimen/spacing_s"
                android:layout_marginTop="@dimen/spacing_m" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l"
                android:paddingHorizontal="@dimen/spacing_s"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:paddingHorizontal="@dimen/spacing_s">

                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="@dimen/elevation_medium"
                        app:cardBackgroundColor="@color/fondo_secundario">

                        <ImageButton
                            android:id="@+id/shuffleButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_shuffle"
                            android:background="?selectableItemBackgroundBorderless"
                            android:tint="@color/texto_secundario"
                            android:padding="@dimen/spacing_xs"
                            android:alpha="0.5" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="@dimen/elevation_medium"
                        app:cardBackgroundColor="@color/fondo_secundario">

                        <ImageButton
                            android:id="@+id/prevButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_skip_previous"
                            android:background="?selectableItemBackgroundBorderless"
                            android:tint="@color/texto_primario"
                            android:padding="@dimen/spacing_xs" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="@dimen/elevation_high"
                        app:cardBackgroundColor="@color/accento_principal">

                        <ImageButton
                            android:id="@+id/playPauseButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_play"
                            android:background="?selectableItemBackgroundBorderless"
                            android:tint="@color/fondo_principal"
                            android:scaleType="center"
                            android:padding="@dimen/spacing_s" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="@dimen/elevation_medium"
                        app:cardBackgroundColor="@color/fondo_secundario">

                        <ImageButton
                            android:id="@+id/nextButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_skip_next"
                            android:background="?selectableItemBackgroundBorderless"
                            android:tint="@color/texto_primario"
                            android:padding="@dimen/spacing_xs" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="@dimen/elevation_medium"
                        app:cardBackgroundColor="@color/fondo_secundario">

                        <ImageButton
                            android:id="@+id/repeatButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_repeat"
                            android:background="?selectableItemBackgroundBorderless"
                            android:tint="@color/texto_secundario"
                            android:padding="@dimen/spacing_xs"
                            android:alpha="0.5" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="@dimen/elevation_medium"
                        app:cardBackgroundColor="@color/fondo_secundario">

                        <ImageButton
                            android:id="@+id/eqButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_equalizer"
                            android:background="?selectableItemBackgroundBorderless"
                            android:tint="@color/texto_secundario"
                            android:padding="@dimen/spacing_xs" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Playlist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:text="PRÓXIMAS CANCIONES" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlistRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>