<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========== PERMISOS ========== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> --> <!-- COMENTADO: No se usa -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature android:name="android.hardware.sensor.proximity" android:required="false" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        android:minSdkVersion="30" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_elegante"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Music1"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">

        <!-- ========== ACTIVITIES ========== -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoadingActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".AvatarActivity"
            android:exported="false" />

        <activity
            android:name=".NuevaBienvenidaActivity"
            android:exported="false" />

        <activity
            android:name=".VideoActivity"
            android:exported="false" />

        <activity
            android:name=".TipoMusicaActivity"
            android:exported="false" />

        <activity
            android:name=".ReproductorLocalActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".ReproductorOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".ListaMusicaLocalActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".BusquedaMusicaActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".FavoritoActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".SugerirActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <activity
            android:name=".PerfilUsuarioActivity"
            android:exported="false"
            android:theme="@style/Theme.Music1" />

        <!-- ========== SERVICE para música en segundo plano ========== -->
        <service
            android:name=".utils.MusicPlayerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>